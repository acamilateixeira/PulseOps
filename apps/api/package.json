{
  "name": "@pulseops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/database/migrate-cli.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/unit/**/*.test.js\"",
    "test:integration": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/integration/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.3.0",
    "@nestjs/core": "^12.3.0",
    "@nestjs/platform-express": "^12.3.0",
    "@pulseops/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0"
  }
}
